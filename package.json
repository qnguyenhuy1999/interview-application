{
  "name": "interview-app",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @interview/api prisma generate",
    "db:push": "pnpm --filter @interview/api prisma db push",
    "db:migrate": "pnpm --filter @interview/api prisma migrate dev",
    "db:studio": "pnpm --filter @interview/api prisma studio"
  }
}
